# postgres://… (Neon in production) · pglite://data/pg (development, embedded, no server) · pglite://memory (tests)
DATABASE_URL=pglite://data/pg
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Sign in with Google (the public site's method): an OAuth client from the Google Cloud console.
# AUTH_GOOGLE_ID=…apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=…
# Email link: a Resend API key in production. Unset in development means SMTP below (Mailpit).
# AUTH_RESEND_KEY=re_…
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Super Colour <noreply@localhost>

# Public origin for social metadata and the API examples on the account page. Production: https://supercolour.app
SITE_URL=https://colorapp-taupe.vercel.app
